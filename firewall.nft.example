#!/usr/sbin/nft -f

# Merge these rules into the host firewall after replacing the example
# addresses. The table has an accept policy and only filters this stack's TCP
# ports, so it does not replace the host's baseline firewall.

table inet high_availability_spilo {
  set cluster_nodes {
    type ipv4_addr
    flags constant
    elements = { 10.0.1.2, 10.0.1.3, 10.0.1.4 }
  }

  set database_clients {
    type ipv4_addr
    flags interval
    elements = { 10.0.2.0/24 }
  }

  set operators {
    type ipv4_addr
    flags interval
    elements = { 10.0.2.10/32 }
  }

  chain input {
    type filter hook input priority filter; policy accept;

    iifname "lo" accept
    ct state established,related accept

    # etcd clients/peers, PostgreSQL replication, and Patroni health checks.
    ip saddr @cluster_nodes tcp dport { 2379, 2380, 5432, 8008 } accept

    # Application traffic enters through HAProxy, never a database node directly.
    ip saddr @database_clients tcp dport { 15432, 15433 } accept

    # etcd administration uses mTLS. Unsafe Patroni calls additionally require
    # Basic authentication and are constrained by Patroni's own allowlist.
    ip saddr @operators tcp dport { 2379, 8008 } accept

    # Exporters are loopback-bound; these drops provide defense in depth.
    tcp dport { 2379, 2380, 5432, 8008, 9100, 9187, 15432, 15433 } drop
  }
}
