# Copy this file to .env on every node. Shared values must be identical on all
# three nodes; only NODE_NAME, NODE_IP, ETCD_NAME, LOCAL_DISK, and PKI_DIR vary.

# This node
NODE_NAME=n1
NODE_IP=10.0.1.2
ETCD_NAME=n1
LOCAL_DISK=/var/lib/high-availability-spilo
PKI_DIR=/etc/high-availability-spilo/pki

# Cluster identity and etcd topology (shared)
SCOPE=spilo-prod
ETCD_INITIAL_CLUSTER=n1=https://10.0.1.2:2380,n2=https://10.0.1.3:2380,n3=https://10.0.1.4:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=replace-with-a-random-cluster-token
ETCD3_HOSTS=10.0.1.2:2379,10.0.1.3:2379,10.0.1.4:2379

# etcd RBAC. The root credential lives only in auth.env on the operator host.
ETCD_USERNAME=patroni
ETCD_PASSWORD=

# Patroni control API. Use a host address or narrow admin CIDR, not the entire LAN.
PATRONI_API_USERNAME=patroni-admin
PATRONI_API_PASSWORD=
PATRONI_API_ALLOWLIST=10.0.2.10/32

# PostgreSQL users
PG_SUPERUSER_PASSWORD=
PG_ADMIN_PASSWORD=
PG_STANDBY_PASSWORD=
PG_EXPORTER_PASSWORD=

# WAL-G / S3
WALG_S3_PREFIX=s3://example-backups/spilo-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
# Leave empty for AWS S3; set an HTTPS endpoint for S3-compatible storage.
AWS_ENDPOINT=

# Grafana Cloud
GRAFANA_CLOUD_API_KEY=
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
